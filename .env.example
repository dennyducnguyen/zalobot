# ============================================
# Zalo Inbox — cấu hình cho 1 domain / 1 kênh
# Copy file này thành .env rồi sửa giá trị
# ============================================

# Server
PORT=3100
HOST=0.0.0.0

# Tên hiển thị của trang (thương hiệu cho từng khách)
APP_NAME=Zalo Inbox

# Database SQLite — 1 file duy nhất, tự tạo khi chạy lần đầu
DB_PATH=./data/inbox.db

# Tài khoản admin đầu tiên — CHỈ dùng để seed khi bảng users trống
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doimatkhau123

# Proxy cho kết nối Zalo (tùy chọn, bỏ trống nếu không dùng)
# Format: http://user:pass@ip:port
ZALO_PROXY=
# MCP remote URL (production cần HTTPS); local mặc định theo PORT
MCP_PUBLIC_URL=http://localhost:3100
MCP_SEND_INTERVAL_MS=2000
MCP_ALLOWED_ORIGINS=

# Trợ lý AI — khóa mã hóa API key/token (base64 32 byte). Tạo: openssl rand -base64 32
# Bỏ trống → app tự sinh và lưu vào data/secret.key (nhớ backup file này cùng inbox.db)
AI_SECRET_KEY=
# Chỉ dùng khi chạy LOCAL để đăng nhập ChatGPT tự động qua cổng 1455; trên VPS để trống (dùng cách dán URL)
AI_OAUTH_LOCAL_CALLBACK=
